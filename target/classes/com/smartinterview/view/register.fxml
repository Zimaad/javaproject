<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<ScrollPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.smartinterview.controller.RegisterController"
            fitToWidth="true" styleClass="auth-root" hbarPolicy="NEVER">

    <StackPane alignment="CENTER" styleClass="auth-backdrop">
        <padding><Insets top="40" bottom="40"/></padding>

        <VBox styleClass="auth-container" alignment="CENTER" spacing="6" maxWidth="500">

            <StackPane styleClass="auth-logo-mark">
                <FontIcon iconLiteral="mdi2b-brain" styleClass="icon-lg, icon-on-accent"/>
            </StackPane>
            <Label text="SMARTINTERVIEW" styleClass="auth-brand">
                <VBox.margin><Insets top="10"/></VBox.margin>
            </Label>

            <Label text="Create your account" styleClass="auth-title">
                <VBox.margin><Insets top="6"/></VBox.margin>
            </Label>
            <Label text="Free for students. No card required." styleClass="auth-subtitle"/>

            <VBox styleClass="auth-form" spacing="15">

                <VBox spacing="6">
                    <HBox spacing="3">
                        <Label text="Full name" styleClass="auth-field-label"/>
                        <Label text="*" styleClass="field-required"/>
                    </HBox>
                    <TextField fx:id="nameField" promptText="Your full name"/>
                </VBox>

                <VBox spacing="6">
                    <HBox spacing="3">
                        <Label text="Email" styleClass="auth-field-label"/>
                        <Label text="*" styleClass="field-required"/>
                    </HBox>
                    <TextField fx:id="emailField" promptText="you@university.edu"/>
                </VBox>

                <HBox spacing="12">
                    <VBox spacing="6" HBox.hgrow="ALWAYS">
                        <HBox spacing="3">
                            <Label text="Password" styleClass="auth-field-label"/>
                            <Label text="*" styleClass="field-required"/>
                        </HBox>
                        <PasswordField fx:id="passwordField" promptText="Create a password"/>
                        <!-- Persistent helper text, not a placeholder that
                             vanishes the moment you start typing. -->
                        <Label text="At least 8 characters." styleClass="field-hint"/>
                    </VBox>
                    <VBox spacing="6" HBox.hgrow="ALWAYS">
                        <HBox spacing="3">
                            <Label text="Confirm password" styleClass="auth-field-label"/>
                            <Label text="*" styleClass="field-required"/>
                        </HBox>
                        <PasswordField fx:id="confirmPasswordField" promptText="Re-enter password"/>
                    </VBox>
                </HBox>

                <VBox spacing="6">
                    <Label text="College / university" styleClass="auth-field-label"/>
                    <TextField fx:id="collegeField" promptText="e.g. MIT Institute of Technology"/>
                </VBox>

                <HBox spacing="12">
                    <VBox spacing="6" HBox.hgrow="ALWAYS">
                        <Label text="Degree" styleClass="auth-field-label"/>
                        <ComboBox fx:id="degreeCombo" promptText="Select degree" maxWidth="1.7976931348623157E308"/>
                    </VBox>
                    <VBox spacing="6" HBox.hgrow="ALWAYS">
                        <Label text="Year" styleClass="auth-field-label"/>
                        <ComboBox fx:id="yearCombo" promptText="Select year" maxWidth="1.7976931348623157E308"/>
                    </VBox>
                </HBox>

                <HBox fx:id="errorBox" styleClass="alert, alert-danger" visible="false" managed="false">
                    <FontIcon iconLiteral="mdi2a-alert-circle-outline" styleClass="icon-sm, icon-danger"/>
                    <Label fx:id="errorLabel" text="" styleClass="alert-text"/>
                </HBox>

                <Button text="Create account" styleClass="btn-primary, btn-large"
                        maxWidth="1.7976931348623157E308" onAction="#onRegister" defaultButton="true">
                    <VBox.margin><Insets top="4"/></VBox.margin>
                </Button>
            </VBox>

            <HBox alignment="CENTER" spacing="6">
                <padding><Insets top="14"/></padding>
                <Label text="Already have an account?" styleClass="auth-footer-text"/>
                <Button text="Sign in" styleClass="link" onAction="#onBackToLogin"/>
            </HBox>
        </VBox>
    </StackPane>
</ScrollPane>
