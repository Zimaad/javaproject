<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>
<?import com.smartinterview.ui.Sidebar?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<BorderPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.smartinterview.controller.ProfileController"
            styleClass="dashboard-root">

    <left>
        <Sidebar active="profile"/>
    </left>

    <center>
        <ScrollPane fitToWidth="true" hbarPolicy="NEVER" styleClass="page-content">
            <VBox>

                <HBox styleClass="page-header" alignment="CENTER_LEFT" spacing="14">
                    <StackPane styleClass="icon-tile, tile-accent">
                        <FontIcon iconLiteral="mdi2a-account-circle-outline" styleClass="icon-lg, icon-accent"/>
                    </StackPane>
                    <VBox spacing="3" HBox.hgrow="ALWAYS">
                        <Label text="My profile" styleClass="page-title"/>
                        <Label text="Manage your personal information and academic details." styleClass="page-subtitle"/>
                    </VBox>
                </HBox>

                <HBox styleClass="profile-section" spacing="24" alignment="TOP_LEFT">

                    <!-- Identity summary -->
                    <VBox styleClass="card" spacing="14" alignment="TOP_CENTER" prefWidth="252" minWidth="252">
                        <StackPane styleClass="avatar, avatar-lg">
                            <Label fx:id="avatarInitials" text="AS" styleClass="avatar-text"/>
                        </StackPane>
                        <Label fx:id="profileName" text="Zimaad Azhari" styleClass="text-h4"/>
                        <Label fx:id="profileRole" text="Student" styleClass="chip, chip-accent"/>
                        <Separator styleClass="divider"/>
                        <VBox spacing="10" alignment="CENTER_LEFT" maxWidth="1.7976931348623157E308">
                            <HBox spacing="10" alignment="CENTER_LEFT">
                                <FontIcon iconLiteral="mdi2e-email-outline" styleClass="icon-sm, icon-muted"/>
                                <Label fx:id="summaryEmail" text="—" styleClass="text-small"/>
                            </HBox>
                            <HBox spacing="10" alignment="CENTER_LEFT">
                                <FontIcon iconLiteral="mdi2s-school-outline" styleClass="icon-sm, icon-muted"/>
                                <Label fx:id="summaryCollege" text="—" styleClass="text-small" wrapText="true"/>
                            </HBox>
                        </VBox>
                    </VBox>

                    <!-- Editable details -->
                    <VBox styleClass="card" spacing="18" HBox.hgrow="ALWAYS">
                        <Label text="Personal information" styleClass="text-title"/>

                        <VBox styleClass="profile-form" spacing="18">
                            <HBox spacing="16">
                                <VBox spacing="6" HBox.hgrow="ALWAYS">
                                    <HBox spacing="3">
                                        <Label text="Full name" styleClass="profile-field-label"/>
                                        <Label text="*" styleClass="field-required"/>
                                    </HBox>
                                    <TextField fx:id="nameField"/>
                                </VBox>
                                <VBox spacing="6" HBox.hgrow="ALWAYS">
                                    <Label text="Email address" styleClass="profile-field-label"/>
                                    <!-- Read-only, not disabled: the two states must look
                                         different, and a disabled field implies it could
                                         become editable. -->
                                    <Label fx:id="emailValue" text="—" styleClass="profile-readonly"/>
                                    <Label text="Your email is used to sign in and cannot be changed." styleClass="field-hint"/>
                                </VBox>
                            </HBox>

                            <VBox spacing="6">
                                <Label text="College / university" styleClass="profile-field-label"/>
                                <TextField fx:id="collegeField"/>
                            </VBox>

                            <HBox spacing="16">
                                <VBox spacing="6" HBox.hgrow="ALWAYS">
                                    <Label text="Degree" styleClass="profile-field-label"/>
                                    <ComboBox fx:id="degreeCombo" maxWidth="1.7976931348623157E308"/>
                                </VBox>
                                <VBox spacing="6" HBox.hgrow="ALWAYS">
                                    <Label text="Year of study" styleClass="profile-field-label"/>
                                    <ComboBox fx:id="yearCombo" maxWidth="1.7976931348623157E308"/>
                                </VBox>
                            </HBox>

                            <HBox fx:id="statusBox" styleClass="alert, alert-success" visible="false" managed="false">
                                <FontIcon iconLiteral="mdi2c-check-circle-outline" styleClass="icon-sm, icon-success"/>
                                <Label fx:id="statusLabel" text="" styleClass="alert-text"/>
                            </HBox>

                            <HBox spacing="12" alignment="CENTER_RIGHT">
                                <Button text="Reset" styleClass="btn-ghost" onAction="#onReset"/>
                                <Button styleClass="btn-primary" onAction="#onSave" text="Save changes">
                                    <graphic><FontIcon iconLiteral="mdi2c-content-save-outline" styleClass="icon-sm"/></graphic>
                                </Button>
                            </HBox>
                        </VBox>
                    </VBox>
                </HBox>
            </VBox>
        </ScrollPane>
    </center>
</BorderPane>
