<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>
<?import com.smartinterview.ui.Sidebar?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<BorderPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.smartinterview.controller.InterviewHistoryController"
            styleClass="dashboard-root">

    <left>
        <Sidebar active="interview-history"/>
    </left>

    <center>
        <VBox styleClass="page-content">

            <HBox styleClass="page-header" alignment="CENTER_LEFT" spacing="14">
                <StackPane styleClass="icon-tile, tile-accent">
                    <FontIcon iconLiteral="mdi2h-history" styleClass="icon-lg, icon-accent"/>
                </StackPane>
                <VBox spacing="3" HBox.hgrow="ALWAYS">
                    <Label text="Interview history" styleClass="page-title"/>
                    <Label text="Review past attempts and track your progress over time." styleClass="page-subtitle"/>
                </VBox>
            </HBox>

            <VBox spacing="16" VBox.vgrow="ALWAYS">
                <padding><Insets top="24" right="32" bottom="32" left="32"/></padding>

                <HBox styleClass="history-filters" alignment="CENTER_LEFT" spacing="12">
                    <StackPane alignment="CENTER_LEFT">
                        <TextField fx:id="searchField" promptText="Search by role" styleClass="search-bar" prefWidth="280"/>
                        <FontIcon iconLiteral="mdi2m-magnify" styleClass="icon-sm, icon-muted, search-icon"/>
                    </StackPane>
                    <Region HBox.hgrow="ALWAYS"/>
                    <ComboBox fx:id="roleCombo" promptText="All roles" prefWidth="164"/>
                    <ComboBox fx:id="periodCombo" promptText="Last 6 months" prefWidth="164"/>
                </HBox>

                <TableView fx:id="historyTable" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="colDate" text="DATE" prefWidth="120"/>
                        <TableColumn fx:id="colRole" text="ROLE" prefWidth="200"/>
                        <TableColumn fx:id="colScore" text="OVERALL SCORE" prefWidth="130"/>
                        <TableColumn fx:id="colDuration" text="DURATION" prefWidth="100"/>
                        <TableColumn fx:id="colAction" text="" prefWidth="120"/>
                    </columns>
                    <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/></columnResizePolicy>
                    <placeholder>
                        <VBox styleClass="empty-state" spacing="12">
                            <FontIcon iconLiteral="mdi2h-history" styleClass="icon-2xl, icon-subtle"/>
                            <Label text="No interviews yet" styleClass="empty-title"/>
                            <Label text="Complete a mock interview and it will show up here with its score." styleClass="empty-text"/>
                        </VBox>
                    </placeholder>
                </TableView>
            </VBox>
        </VBox>
    </center>
</BorderPane>
