<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>
<?import com.smartinterview.ui.Sidebar?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<BorderPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.smartinterview.controller.PerformanceReportController"
            styleClass="dashboard-root">

    <left>
        <Sidebar active="performance-report"/>
    </left>

    <center>
        <ScrollPane fitToWidth="true" hbarPolicy="NEVER" styleClass="page-content">
            <VBox>

                <HBox styleClass="page-header" alignment="CENTER_LEFT" spacing="14">
                    <StackPane styleClass="icon-tile, tile-accent">
                        <FontIcon iconLiteral="mdi2c-chart-line" styleClass="icon-lg, icon-accent"/>
                    </StackPane>
                    <VBox spacing="3" HBox.hgrow="ALWAYS">
                        <Label text="Performance report" styleClass="page-title"/>
                        <Label fx:id="reportSubtitle" text="" styleClass="page-subtitle"/>
                    </VBox>
                </HBox>

                <VBox styleClass="report-content" spacing="24">

                    <!-- ===== Score + round breakdown ===== -->
                    <HBox styleClass="report-hero" spacing="28" alignment="CENTER_LEFT">
                        <VBox alignment="CENTER" spacing="14" prefWidth="210" minWidth="210">
                            <StackPane fx:id="scoreCircle" styleClass="score-circle">
                                <VBox alignment="CENTER" spacing="0">
                                    <Label fx:id="overallScoreLabel" text="85%" styleClass="score-value"/>
                                    <Label text="OVERALL" styleClass="score-label"/>
                                </VBox>
                            </StackPane>
                            <HBox fx:id="verdictBox" spacing="7" alignment="CENTER">
                                <FontIcon fx:id="verdictIcon" iconLiteral="mdi2t-thumb-up-outline" styleClass="icon-sm, icon-success"/>
                                <Label fx:id="verdictLabel" text="Strong result" styleClass="text-small, text-medium"/>
                            </HBox>
                        </VBox>

                        <Separator orientation="VERTICAL"/>

                        <VBox spacing="16" HBox.hgrow="ALWAYS">
                            <Label text="Round breakdown" styleClass="card-title"/>
                            <VBox fx:id="roundsContainer" spacing="14"/>
                        </VBox>
                    </HBox>

                    <!-- ===== Strengths / gaps ===== -->
                    <HBox spacing="20">
                        <VBox styleClass="report-card" HBox.hgrow="ALWAYS">
                            <HBox spacing="10" alignment="CENTER_LEFT">
                                <FontIcon iconLiteral="mdi2c-check-circle-outline" styleClass="icon-md, icon-success"/>
                                <Label text="Strengths" styleClass="card-title"/>
                            </HBox>
                            <VBox fx:id="strengthsContainer" spacing="10"/>
                        </VBox>

                        <VBox styleClass="report-card" HBox.hgrow="ALWAYS">
                            <HBox spacing="10" alignment="CENTER_LEFT">
                                <FontIcon iconLiteral="mdi2a-alert-circle-outline" styleClass="icon-md, icon-danger"/>
                                <Label text="Areas to improve" styleClass="card-title"/>
                            </HBox>
                            <VBox fx:id="weaknessesContainer" spacing="10"/>
                        </VBox>
                    </HBox>

                    <!-- ===== Recommendations ===== -->
                    <VBox styleClass="report-card">
                        <HBox spacing="10" alignment="CENTER_LEFT">
                            <FontIcon iconLiteral="mdi2l-lightbulb-on-outline" styleClass="icon-md, icon-accent"/>
                            <Label text="Recommended next steps" styleClass="card-title"/>
                        </HBox>
                        <VBox fx:id="recommendationsContainer" spacing="10"/>
                    </VBox>

                    <HBox spacing="12" alignment="CENTER_RIGHT">
                        <Button styleClass="btn-secondary" onAction="#onExport" text="Export report">
                            <graphic><FontIcon iconLiteral="mdi2f-file-export-outline" styleClass="icon-sm"/></graphic>
                        </Button>
                        <Button text="Back to dashboard" styleClass="btn-primary" onAction="#onNavDashboard"/>
                    </HBox>
                </VBox>
            </VBox>
        </ScrollPane>
    </center>
</BorderPane>
