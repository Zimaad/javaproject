<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.chart.*?>
<?import javafx.geometry.Insets?>
<?import com.smartinterview.ui.Sidebar?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<!--
  Student dashboard.

  The sidebar is the shared Sidebar control — it renders the nav, marks
  the active item and handles its own navigation, so this file only
  describes the page body.
-->
<BorderPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.smartinterview.controller.DashboardController"
            styleClass="dashboard-root">

    <left>
        <Sidebar active="dashboard"/>
    </left>

    <center>
        <ScrollPane fitToWidth="true" hbarPolicy="NEVER" styleClass="page-content">
            <VBox styleClass="dashboard-content" spacing="28">

                <!-- ===== Greeting ===== -->
                <HBox alignment="CENTER_LEFT" spacing="16">
                    <VBox styleClass="dashboard-header" spacing="6" HBox.hgrow="ALWAYS">
                        <Label fx:id="greetingLabel" text="Good evening, Zimaad " styleClass="greeting"/>
                        <Label text="Ready for your next interview?" styleClass="greeting-sub"/>
                    </VBox>
                    <Button styleClass="btn-primary, btn-large" onAction="#onNavInterview" text="Start interview">
                        <graphic><FontIcon iconLiteral="mdi2p-plus" styleClass="icon-sm"/></graphic>
                    </Button>
                </HBox>

                <!-- ===== Stats ===== -->
                <HBox styleClass="stats-grid" spacing="16">
                    <VBox styleClass="stat-card" HBox.hgrow="ALWAYS">
                        <HBox spacing="14" alignment="CENTER_LEFT">
                            <StackPane styleClass="icon-tile, tile-accent">
                                <FontIcon iconLiteral="mdi2c-clipboard-text-outline" styleClass="icon-lg, icon-accent"/>
                            </StackPane>
                            <VBox spacing="1">
                                <Label fx:id="interviewsCount" text="12" styleClass="stat-value"/>
                                <Label text="Interviews completed" styleClass="stat-label"/>
                            </VBox>
                        </HBox>
                    </VBox>

                    <VBox styleClass="stat-card" HBox.hgrow="ALWAYS">
                        <HBox spacing="14" alignment="CENTER_LEFT">
                            <StackPane styleClass="icon-tile, tile-success">
                                <FontIcon iconLiteral="mdi2c-chart-box-outline" styleClass="icon-lg, icon-success"/>
                            </StackPane>
                            <VBox spacing="1">
                                <Label fx:id="avgScore" text="84%" styleClass="stat-value"/>
                                <Label text="Average score" styleClass="stat-label"/>
                            </VBox>
                        </HBox>
                    </VBox>

                    <VBox styleClass="stat-card" HBox.hgrow="ALWAYS">
                        <HBox spacing="14" alignment="CENTER_LEFT">
                            <StackPane styleClass="icon-tile, tile-warning">
                                <FontIcon iconLiteral="mdi2t-trophy-outline" styleClass="icon-lg, icon-warning"/>
                            </StackPane>
                            <VBox spacing="1">
                                <Label fx:id="bestScore" text="91%" styleClass="stat-value"/>
                                <Label text="Best score" styleClass="stat-label"/>
                            </VBox>
                        </HBox>
                    </VBox>

                    <VBox styleClass="stat-card" HBox.hgrow="ALWAYS">
                        <HBox spacing="14" alignment="CENTER_LEFT">
                            <StackPane styleClass="icon-tile, tile-info">
                                <FontIcon iconLiteral="mdi2c-check-circle-outline" styleClass="icon-lg, icon-info"/>
                            </StackPane>
                            <VBox spacing="1">
                                <Label fx:id="questionsCount" text="127" styleClass="stat-value"/>
                                <Label text="Questions answered" styleClass="stat-label"/>
                            </VBox>
                        </HBox>
                    </VBox>
                </HBox>

                <!-- ===== Performance chart ===== -->
                <VBox styleClass="chart-container" spacing="4">
                    <HBox alignment="CENTER_LEFT" spacing="10">
                        <VBox spacing="2" HBox.hgrow="ALWAYS">
                            <Label text="Performance trend" styleClass="chart-title"/>
                            <Label text="Score per interview, most recent last" styleClass="chart-caption"/>
                        </VBox>
                        <FontIcon iconLiteral="mdi2t-trending-up" styleClass="icon-md, icon-success"/>
                    </HBox>
                    <LineChart fx:id="performanceChart" prefHeight="248" animated="false" createSymbols="true"
                               legendVisible="false">
                        <xAxis><CategoryAxis label="Interview"/></xAxis>
                        <yAxis><NumberAxis label="Score %" lowerBound="0" upperBound="100" tickUnit="20" autoRanging="false"/></yAxis>
                    </LineChart>
                </VBox>

                <!-- ===== Recent interviews ===== -->
                <VBox styleClass="recent-section" spacing="14">
                    <HBox alignment="CENTER_LEFT" spacing="10">
                        <Label text="Recent interviews" styleClass="section-title" HBox.hgrow="ALWAYS"/>
                        <Button text="View all" styleClass="btn-ghost, btn-small" onAction="#onNavHistory"
                                contentDisplay="RIGHT">
                            <graphic><FontIcon iconLiteral="mdi2a-arrow-right" styleClass="icon-xs"/></graphic>
                        </Button>
                    </HBox>
                    <TableView fx:id="recentTable" prefHeight="200">
                        <columns>
                            <TableColumn fx:id="colRole" text="ROLE" prefWidth="200"/>
                            <TableColumn fx:id="colScore" text="SCORE" prefWidth="100"/>
                            <TableColumn fx:id="colDate" text="DATE" prefWidth="150"/>
                            <TableColumn fx:id="colDuration" text="DURATION" prefWidth="120"/>
                        </columns>
                        <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/></columnResizePolicy>
                        <placeholder>
                            <VBox styleClass="empty-state" spacing="12">
                                <FontIcon iconLiteral="mdi2c-clipboard-list-outline" styleClass="icon-2xl, icon-subtle"/>
                                <Label text="No interviews yet" styleClass="empty-title"/>
                                <Label text="Your completed interviews will appear here." styleClass="empty-text"/>
                            </VBox>
                        </placeholder>
                    </TableView>
                </VBox>

                <!-- ===== Continue preparation ===== -->
                <VBox styleClass="continue-section" spacing="14">
                    <Label text="Continue preparation" styleClass="section-title"/>
                    <HBox spacing="16">
                        <VBox styleClass="continue-card" HBox.hgrow="ALWAYS">
                            <HBox spacing="10" alignment="CENTER_LEFT">
                                <FontIcon iconLiteral="mdi2c-coffee-outline" styleClass="icon-sm, icon-accent"/>
                                <Label text="Java fundamentals" styleClass="topic-title"/>
                            </HBox>
                            <ProgressBar progress="0.75" maxWidth="1.7976931348623157E308"/>
                            <Label text="75% complete · 15 questions" styleClass="topic-progress"/>
                        </VBox>

                        <VBox styleClass="continue-card" HBox.hgrow="ALWAYS">
                            <HBox spacing="10" alignment="CENTER_LEFT">
                                <FontIcon iconLiteral="mdi2f-file-tree-outline" styleClass="icon-sm, icon-info"/>
                                <Label text="Data structures" styleClass="topic-title"/>
                            </HBox>
                            <ProgressBar progress="0.45" maxWidth="1.7976931348623157E308"/>
                            <Label text="45% complete · 20 questions" styleClass="topic-progress"/>
                        </VBox>

                        <VBox styleClass="continue-card" HBox.hgrow="ALWAYS">
                            <HBox spacing="10" alignment="CENTER_LEFT">
                                <FontIcon iconLiteral="mdi2d-database-outline" styleClass="icon-sm, icon-success"/>
                                <Label text="SQL &amp; databases" styleClass="topic-title"/>
                            </HBox>
                            <ProgressBar progress="0.60" maxWidth="1.7976931348623157E308"/>
                            <Label text="60% complete · 12 questions" styleClass="topic-progress"/>
                        </VBox>

                        <VBox styleClass="continue-card" HBox.hgrow="ALWAYS">
                            <HBox spacing="10" alignment="CENTER_LEFT">
                                <FontIcon iconLiteral="mdi2a-account-voice" styleClass="icon-sm, icon-warning"/>
                                <Label text="HR behavioural" styleClass="topic-title"/>
                            </HBox>
                            <ProgressBar progress="0.30" maxWidth="1.7976931348623157E308"/>
                            <Label text="30% complete · 10 questions" styleClass="topic-progress"/>
                        </VBox>
                    </HBox>
                </VBox>
            </VBox>
        </ScrollPane>
    </center>
</BorderPane>
