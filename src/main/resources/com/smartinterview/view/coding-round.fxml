<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<BorderPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.smartinterview.controller.CodingRoundController"
            styleClass="coding-root">

    <top>
        <HBox styleClass="round-bar">
            <VBox styleClass="round-info" HBox.hgrow="ALWAYS">
                <Label fx:id="roundProgressLabel" text="ROUND 2 OF 3 · CODING CHALLENGE" styleClass="round-label"/>
                <Label fx:id="roleLabel" text="Java Developer" styleClass="round-value"/>
            </VBox>

            <VBox alignment="CENTER_RIGHT" spacing="6">
                <Label fx:id="timerLabel" text="45:00" styleClass="timer-display" contentDisplay="LEFT">
                    <graphic><FontIcon iconLiteral="mdi2t-timer-outline" styleClass="icon-sm, icon-muted"/></graphic>
                </Label>
                <HBox spacing="10" alignment="CENTER_RIGHT">
                    <ProgressBar fx:id="progressBar" progress="0.5" prefWidth="150"/>
                    <Label fx:id="progressLabel" text="1/2" styleClass="progress-text"/>
                </HBox>
            </VBox>
        </HBox>
    </top>

    <center>
        <SplitPane dividerPositions="0.42">

            <!-- ===== Problem statement ===== -->
            <VBox styleClass="problem-panel">
                <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS">
                    <VBox spacing="16">
                        <padding><Insets right="14"/></padding>

                        <HBox alignment="CENTER_LEFT" spacing="8">
                            <Label fx:id="difficultyBadge" text="Medium" styleClass="badge, badge-medium"/>
                            <Label fx:id="categoryBadge" text="Arrays" styleClass="badge, badge-category"/>
                        </HBox>

                        <Label fx:id="problemTitle" text="Two Sum" styleClass="problem-title"/>
                        <Label fx:id="problemText" styleClass="problem-text"
                               text="Loading problem description…"/>
                    </VBox>
                </ScrollPane>

                <Separator styleClass="divider"/>

                <HBox spacing="10" alignment="CENTER_LEFT">
                    <padding><Insets top="14"/></padding>
                    <Button fx:id="btnPrev" text="Previous" styleClass="btn-secondary, btn-small" onAction="#onPrevQuestion">
                        <graphic><FontIcon iconLiteral="mdi2a-arrow-left" styleClass="icon-xs"/></graphic>
                    </Button>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Button fx:id="btnNext" text="Next challenge" styleClass="btn-secondary, btn-small"
                            onAction="#onNextQuestion" contentDisplay="RIGHT">
                        <graphic><FontIcon iconLiteral="mdi2a-arrow-right" styleClass="icon-xs"/></graphic>
                    </Button>
                </HBox>
            </VBox>

            <!-- ===== Editor ===== -->
            <VBox styleClass="editor-panel">

                <HBox styleClass="editor-toolbar" alignment="CENTER_LEFT" spacing="10">
                    <FontIcon iconLiteral="mdi2c-code-braces" styleClass="icon-sm, icon-muted"/>
                    <Label fx:id="fileNameLabel" text="Solution.java" styleClass="editor-filename"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <ComboBox fx:id="languageCombo" promptText="Java" prefWidth="124"/>
                    <Button fx:id="btnRun" text="Run" styleClass="btn-secondary, btn-small" onAction="#onRunCode">
                        <graphic><FontIcon iconLiteral="mdi2p-play" styleClass="icon-xs"/></graphic>
                    </Button>
                    <Button fx:id="btnSubmit" text="Submit" styleClass="btn-primary, btn-small" onAction="#onSubmitSolution">
                        <graphic><FontIcon iconLiteral="mdi2c-check" styleClass="icon-xs"/></graphic>
                    </Button>
                </HBox>

                <TextArea fx:id="codeArea" VBox.vgrow="ALWAYS" styleClass="code-editor"
                          promptText="Write your solution here…"/>

                <VBox fx:id="consolePanel" styleClass="console-panel" visible="false" managed="false">
                    <HBox alignment="CENTER_LEFT" spacing="8">
                        <FontIcon iconLiteral="mdi2c-console" styleClass="icon-xs, icon-subtle"/>
                        <Label text="CONSOLE" styleClass="console-title" HBox.hgrow="ALWAYS"/>
                        <Button styleClass="btn-icon, console-close" onAction="#onCloseConsole">
                            <graphic><FontIcon iconLiteral="mdi2c-close" styleClass="icon-xs"/></graphic>
                            <tooltip><Tooltip text="Close console"/></tooltip>
                        </Button>
                    </HBox>
                    <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS">
                        <Label fx:id="consoleOutput" text="" styleClass="console-output" wrapText="true"/>
                    </ScrollPane>
                </VBox>
            </VBox>
        </SplitPane>
    </center>
</BorderPane>
