<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>
<?import com.smartinterview.ui.Sidebar?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<BorderPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.smartinterview.controller.InterviewConfigController"
            styleClass="config-root">

    <left>
        <Sidebar active="interview-select"/>
    </left>

    <center>
        <ScrollPane fitToWidth="true" hbarPolicy="NEVER" styleClass="page-content">
            <VBox>

                <VBox styleClass="page-header" spacing="6">
                    <Button text="Back to roles" styleClass="btn-ghost, btn-small" onAction="#onNavInterview">
                        <graphic><FontIcon iconLiteral="mdi2a-arrow-left" styleClass="icon-xs"/></graphic>
                    </Button>
                    <Label fx:id="roleTitleLabel" text="Configure interview" styleClass="page-title"/>
                    <Label text="Set the shape of your mock interview before you start." styleClass="page-subtitle"/>
                </VBox>

                <HBox styleClass="config-body, config-container" spacing="28">

                    <!-- ===== Options ===== -->
                    <VBox spacing="24" HBox.hgrow="ALWAYS" maxWidth="620">

                        <VBox styleClass="config-section">
                            <Label text="Difficulty" styleClass="config-label"/>
                            <Label text="Harder settings draw from a deeper question pool." styleClass="config-hint"/>
                            <HBox styleClass="config-options">
                                <ToggleButton fx:id="btnEasy" text="Easy" onAction="#onUpdateSummary"/>
                                <ToggleButton fx:id="btnMedium" text="Medium" selected="true" onAction="#onUpdateSummary"/>
                                <ToggleButton fx:id="btnHard" text="Hard" onAction="#onUpdateSummary"/>
                            </HBox>
                        </VBox>

                        <Separator styleClass="divider"/>

                        <VBox styleClass="config-section">
                            <Label text="Rounds" styleClass="config-label"/>
                            <Label text="Pick at least one round to include." styleClass="config-hint"/>
                            <VBox spacing="12">
                                <CheckBox fx:id="chkMcq" text="Multiple choice" selected="true" onAction="#onUpdateSummary"/>
                                <CheckBox fx:id="chkCoding" text="Coding challenges" selected="true" onAction="#onUpdateSummary"/>
                                <CheckBox fx:id="chkHr" text="HR &amp; behavioural" selected="true" onAction="#onUpdateSummary"/>
                            </VBox>
                        </VBox>

                        <Separator styleClass="divider"/>

                        <VBox styleClass="config-section">
                            <Label text="Duration" styleClass="config-label"/>
                            <HBox styleClass="config-options">
                                <ToggleButton fx:id="btn15m" text="15 min" onAction="#onUpdateSummary"/>
                                <ToggleButton fx:id="btn30m" text="30 min" selected="true" onAction="#onUpdateSummary"/>
                                <ToggleButton fx:id="btn45m" text="45 min" onAction="#onUpdateSummary"/>
                            </HBox>
                        </VBox>

                        <VBox styleClass="config-section">
                            <Label text="Number of questions" styleClass="config-label"/>
                            <HBox styleClass="config-options">
                                <ToggleButton fx:id="btn5q" text="5" onAction="#onUpdateSummary"/>
                                <ToggleButton fx:id="btn10q" text="10" selected="true" onAction="#onUpdateSummary"/>
                                <ToggleButton fx:id="btn15q" text="15" onAction="#onUpdateSummary"/>
                            </HBox>
                        </VBox>
                    </VBox>

                    <!-- ===== Summary ===== -->
                    <VBox styleClass="config-summary">
                        <HBox spacing="10" alignment="CENTER_LEFT">
                            <FontIcon iconLiteral="mdi2c-clipboard-text-outline" styleClass="icon-md, icon-accent"/>
                            <Label text="Interview summary" styleClass="summary-title"/>
                        </HBox>
                        <Separator styleClass="divider"/>

                        <VBox spacing="14">
                            <VBox styleClass="summary-row">
                                <Label text="ROLE" styleClass="summary-label"/>
                                <Label fx:id="summaryRole" text="—" styleClass="summary-value" wrapText="true"/>
                            </VBox>

                            <VBox styleClass="summary-row">
                                <Label text="ROUNDS" styleClass="summary-label"/>
                                <Label fx:id="summaryRounds" text="—" styleClass="summary-value, text-accent" wrapText="true"/>
                            </VBox>

                            <VBox styleClass="summary-row">
                                <Label text="DIFFICULTY" styleClass="summary-label"/>
                                <Label fx:id="summaryDifficulty" text="Medium" styleClass="summary-value"/>
                            </VBox>

                            <HBox spacing="24">
                                <VBox styleClass="summary-row">
                                    <Label text="DURATION" styleClass="summary-label"/>
                                    <Label fx:id="summaryDuration" text="30 min" styleClass="summary-value"/>
                                </VBox>
                                <VBox styleClass="summary-row">
                                    <Label text="QUESTIONS" styleClass="summary-label"/>
                                    <Label fx:id="summaryQuestions" text="10" styleClass="summary-value"/>
                                </VBox>
                            </HBox>
                        </VBox>

                        <Region VBox.vgrow="ALWAYS"/>

                        <HBox fx:id="errorBox" styleClass="alert, alert-danger" visible="false" managed="false">
                            <FontIcon iconLiteral="mdi2a-alert-circle-outline" styleClass="icon-sm, icon-danger"/>
                            <Label fx:id="errorLabel" text="" styleClass="alert-text"/>
                        </HBox>

                        <Button text="Start interview" styleClass="btn-primary, btn-large"
                                maxWidth="1.7976931348623157E308" onAction="#onStartInterview">
                            <graphic><FontIcon iconLiteral="mdi2p-play" styleClass="icon-sm"/></graphic>
                        </Button>
                    </VBox>
                </HBox>
            </VBox>
        </ScrollPane>
    </center>
</BorderPane>
