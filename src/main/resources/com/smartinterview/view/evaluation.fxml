<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<!--
  Evaluation progress screen. Each step is a StackPane marker plus a
  label; EvaluationController swaps the marker's icon and style class
  as the simulated analysis advances.
-->
<BorderPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.smartinterview.controller.EvaluationController"
            styleClass="eval-root">

    <center>
        <VBox styleClass="eval-container" alignment="CENTER" spacing="10">

            <StackPane styleClass="icon-tile, icon-tile-lg, tile-accent">
                <FontIcon iconLiteral="mdi2r-robot-outline" styleClass="icon-xl, icon-accent"/>
            </StackPane>

            <Label text="Generating your report" styleClass="eval-title"/>
            <Label text="Analysing your answers across every round." styleClass="eval-subtitle"/>

            <VBox styleClass="eval-steps" spacing="6">

                <HBox fx:id="step1" styleClass="eval-step">
                    <StackPane fx:id="icon1" styleClass="step-icon, step-icon-pending">
                        <Label text="1"/>
                    </StackPane>
                    <Label text="Analysing multiple-choice answers" styleClass="step-text, step-text-pending"/>
                </HBox>

                <HBox fx:id="step2" styleClass="eval-step">
                    <StackPane fx:id="icon2" styleClass="step-icon, step-icon-pending">
                        <Label text="2"/>
                    </StackPane>
                    <Label text="Checking code correctness and efficiency" styleClass="step-text, step-text-pending"/>
                </HBox>

                <HBox fx:id="step3" styleClass="eval-step">
                    <StackPane fx:id="icon3" styleClass="step-icon, step-icon-pending">
                        <Label text="3"/>
                    </StackPane>
                    <Label text="Reviewing behavioural responses" styleClass="step-text, step-text-pending"/>
                </HBox>

                <HBox fx:id="step4" styleClass="eval-step">
                    <StackPane fx:id="icon4" styleClass="step-icon, step-icon-pending">
                        <Label text="4"/>
                    </StackPane>
                    <Label text="Writing personalised feedback" styleClass="step-text, step-text-pending"/>
                </HBox>
            </VBox>

            <ProgressIndicator fx:id="progressIndicator" prefWidth="34" prefHeight="34"/>

            <Button fx:id="btnViewReport" styleClass="btn-primary, btn-large" text="View complete report"
                    visible="false" managed="false" onAction="#onViewReport" contentDisplay="RIGHT">
                <graphic><FontIcon iconLiteral="mdi2a-arrow-right" styleClass="icon-sm"/></graphic>
                <VBox.margin><Insets top="12"/></VBox.margin>
            </Button>
        </VBox>
    </center>
</BorderPane>
