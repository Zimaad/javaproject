<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>
<?import com.smartinterview.ui.Sidebar?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<!-- Role picker. Cards are built by InterviewSelectController. -->
<BorderPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.smartinterview.controller.InterviewSelectController"
            styleClass="dashboard-root">

    <left>
        <Sidebar active="interview-select"/>
    </left>

    <center>
        <ScrollPane fitToWidth="true" hbarPolicy="NEVER" styleClass="page-content">
            <VBox styleClass="interview-select-root">

                <HBox styleClass="page-header" alignment="CENTER_LEFT" spacing="14">
                    <StackPane styleClass="icon-tile, tile-accent">
                        <FontIcon iconLiteral="mdi2t-target" styleClass="icon-lg, icon-accent"/>
                    </StackPane>
                    <VBox spacing="3" HBox.hgrow="ALWAYS">
                        <Label text="Choose your interview" styleClass="page-title"/>
                        <Label text="Pick a job role to begin a mock interview assessment." styleClass="page-subtitle"/>
                    </VBox>
                </HBox>

                <FlowPane fx:id="rolesFlowPane" styleClass="roles-grid" hgap="18" vgap="18"/>
            </VBox>
        </ScrollPane>
    </center>
</BorderPane>
