<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>
<?import com.smartinterview.ui.Sidebar?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<!-- Question bank. Rows are built by QuestionBankController. -->
<BorderPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.smartinterview.controller.QuestionBankController"
            styleClass="dashboard-root">

    <left>
        <Sidebar active="question-bank"/>
    </left>

    <center>
        <ScrollPane fitToWidth="true" hbarPolicy="NEVER" styleClass="page-content">
            <VBox>

                <HBox styleClass="page-header" alignment="CENTER_LEFT" spacing="14">
                    <StackPane styleClass="icon-tile, tile-accent">
                        <FontIcon iconLiteral="mdi2b-book-open-outline" styleClass="icon-lg, icon-accent"/>
                    </StackPane>
                    <VBox spacing="3" HBox.hgrow="ALWAYS">
                        <Label text="Question bank" styleClass="page-title"/>
                        <Label text="Browse and practise individual questions from the curated set." styleClass="page-subtitle"/>
                    </VBox>
                    <Label fx:id="resultCountLabel" text="" styleClass="text-small"/>
                </HBox>

                <VBox styleClass="qbank-content" spacing="16">

                    <!-- Filters. The search field carries an overlaid icon
                         rather than an emoji inside its prompt text. -->
                    <HBox styleClass="history-filters" alignment="CENTER_LEFT" spacing="12">
                        <StackPane alignment="CENTER_LEFT">
                            <TextField fx:id="searchField" promptText="Search questions" styleClass="search-bar" prefWidth="320"/>
                            <FontIcon iconLiteral="mdi2m-magnify" styleClass="icon-sm, icon-muted, search-icon"/>
                        </StackPane>
                        <Region HBox.hgrow="ALWAYS"/>
                        <ComboBox fx:id="categoryCombo" promptText="Category" prefWidth="134"/>
                        <ComboBox fx:id="difficultyCombo" promptText="Difficulty" prefWidth="134"/>
                        <ComboBox fx:id="typeCombo" promptText="Type" prefWidth="118"/>
                    </HBox>

                    <VBox fx:id="questionsContainer" spacing="14"/>
                </VBox>
            </VBox>
        </ScrollPane>
    </center>
</BorderPane>
