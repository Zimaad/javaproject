<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<BorderPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.smartinterview.controller.HrRoundController"
            styleClass="hr-root">

    <top>
        <HBox styleClass="round-bar">
            <VBox styleClass="round-info" HBox.hgrow="ALWAYS">
                <Label fx:id="roundProgressLabel" text="ROUND 3 OF 3 · HR &amp; BEHAVIOURAL" styleClass="round-label"/>
                <Label fx:id="roleLabel" text="Java Developer" styleClass="round-value"/>
            </VBox>

            <VBox alignment="CENTER_RIGHT" spacing="6">
                <Label fx:id="timerLabel" text="15:00" styleClass="timer-display" contentDisplay="LEFT">
                    <graphic><FontIcon iconLiteral="mdi2t-timer-outline" styleClass="icon-sm, icon-muted"/></graphic>
                </Label>
                <HBox spacing="10" alignment="CENTER_RIGHT">
                    <ProgressBar fx:id="progressBar" progress="0.33" prefWidth="150"/>
                    <Label fx:id="progressLabel" text="1/3" styleClass="progress-text"/>
                </HBox>
            </VBox>
        </HBox>
    </top>

    <center>
        <ScrollPane fitToWidth="true" hbarPolicy="NEVER" styleClass="page-content">
            <VBox alignment="TOP_CENTER">
                <VBox styleClass="hr-content" spacing="22">

                    <HBox alignment="CENTER_LEFT" spacing="10">
                        <Label fx:id="categoryBadge" text="Behavioural" styleClass="badge, badge-category"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Label fx:id="qNumberLabel" text="1/3" styleClass="progress-text"/>
                    </HBox>

                    <Label fx:id="questionTextLabel" styleClass="hr-question"
                           text="Loading question…"/>

                    <!-- Guidance panel: icon + heading + body -->
                    <VBox styleClass="hr-tip">
                        <HBox spacing="8" alignment="CENTER_LEFT">
                            <FontIcon iconLiteral="mdi2l-lightbulb-on-outline" styleClass="icon-sm, icon-accent"/>
                            <Label text="INTERVIEW TIP" styleClass="tip-title"/>
                        </HBox>
                        <Label fx:id="tipLabel" styleClass="tip-text"
                               text="Use the STAR method: Situation, Task, Action, Result. Keep the focus on what you did and what changed as a result."/>
                    </VBox>

                    <VBox spacing="8">
                        <Label text="Your response" styleClass="field-label"/>
                        <TextArea fx:id="answerArea" prefHeight="240" wrapText="true"
                                  promptText="Type your response here — aim for 100 to 250 words."/>
                        <HBox alignment="CENTER_LEFT" spacing="10">
                            <Label text="Aim for 100–250 words." styleClass="field-hint" HBox.hgrow="ALWAYS"/>
                            <Label fx:id="charCountLabel" text="0 / 2000" styleClass="char-count"/>
                        </HBox>
                    </VBox>

                    <HBox spacing="12" alignment="CENTER">
                        <padding><Insets top="8"/></padding>
                        <Button fx:id="btnPrev" text="Previous" styleClass="btn-secondary" onAction="#onPrevQuestion">
                            <graphic><FontIcon iconLiteral="mdi2a-arrow-left" styleClass="icon-sm"/></graphic>
                        </Button>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Button fx:id="btnNext" text="Next question" styleClass="btn-primary" onAction="#onNextQuestion"
                                contentDisplay="RIGHT">
                            <graphic><FontIcon iconLiteral="mdi2a-arrow-right" styleClass="icon-sm"/></graphic>
                        </Button>
                    </HBox>
                </VBox>
            </VBox>
        </ScrollPane>
    </center>
</BorderPane>
