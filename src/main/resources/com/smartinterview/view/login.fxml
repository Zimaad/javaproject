<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<StackPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
           fx:controller="com.smartinterview.controller.LoginController"
           styleClass="auth-root, auth-backdrop">

    <VBox alignment="CENTER" maxWidth="440">

        <VBox styleClass="auth-container" alignment="CENTER" spacing="6">

            <StackPane styleClass="auth-logo-mark">
                <FontIcon iconLiteral="mdi2b-brain" styleClass="icon-lg, icon-on-accent"/>
            </StackPane>
            <Label text="SMARTINTERVIEW" styleClass="auth-brand">
                <VBox.margin><Insets top="10"/></VBox.margin>
            </Label>

            <Label text="Welcome back" styleClass="auth-title">
                <VBox.margin><Insets top="6"/></VBox.margin>
            </Label>
            <Label text="Sign in to continue your interview prep." styleClass="auth-subtitle"/>

            <VBox styleClass="auth-form" spacing="16">
                <VBox spacing="6">
                    <Label text="Email" styleClass="auth-field-label"/>
                    <TextField fx:id="emailField" promptText="you@university.edu"/>
                </VBox>

                <VBox spacing="6">
                    <HBox alignment="CENTER_LEFT">
                        <Label text="Password" styleClass="auth-field-label" HBox.hgrow="ALWAYS"/>
                        <Button text="Forgot password?" styleClass="link" onAction="#onForgotPassword"/>
                    </HBox>
                    <PasswordField fx:id="passwordField" promptText="Enter your password"/>
                </VBox>

                <!-- Errors sit with the form and pair an icon with the text. -->
                <HBox fx:id="errorBox" styleClass="alert, alert-danger" visible="false" managed="false">
                    <FontIcon iconLiteral="mdi2a-alert-circle-outline" styleClass="icon-sm, icon-danger"/>
                    <Label fx:id="errorLabel" text="" styleClass="alert-text"/>
                </HBox>

                <Button fx:id="loginButton" text="Sign in" styleClass="btn-primary, btn-large"
                        maxWidth="1.7976931348623157E308" onAction="#onLogin" defaultButton="true"/>
            </VBox>

            <HBox alignment="CENTER" spacing="12">
                <padding><Insets top="14" bottom="10"/></padding>
                <Separator HBox.hgrow="ALWAYS"/>
                <Label text="OR" styleClass="auth-divider-text"/>
                <Separator HBox.hgrow="ALWAYS"/>
            </HBox>

            <HBox alignment="CENTER" spacing="6">
                <Label text="Don't have an account?" styleClass="auth-footer-text"/>
                <Button text="Create one" styleClass="link" onAction="#onRegister"/>
            </HBox>

            <Button text="Sign in as administrator" styleClass="btn-ghost, btn-small" onAction="#onAdminLogin"
                    contentDisplay="LEFT">
                <graphic><FontIcon iconLiteral="mdi2s-shield-account-outline" styleClass="icon-xs"/></graphic>
                <VBox.margin><Insets top="10"/></VBox.margin>
            </Button>

            <!-- This is a mock build, so the demo credentials are stated
                 rather than left for the user to guess. -->
            <HBox styleClass="auth-hint">
                <padding><Insets top="0"/></padding>
                <VBox.margin><Insets top="14"/></VBox.margin>
                <FontIcon iconLiteral="mdi2i-information-outline" styleClass="icon-sm, icon-muted"/>
                <VBox spacing="2">
                    <Label text="Demo build — any email and password will sign you in." styleClass="hint-text"/>
                </VBox>
            </HBox>
        </VBox>
    </VBox>
</StackPane>
